          "@type": "Question",
          "name": "What brands of golf carts do you sell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We are authorized dealers for DENAGO and EVOLUTION electric golf carts, offering multiple models ranging from 2-seater to 8-seater configurations with various features and capabilities."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer golf cart rentals?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! We offer daily ($245-$295), 3-day ($685-$825), weekly ($1,400-$1,680), and monthly ($4,200-$5,040) golf cart rentals with delivery throughout Gloucester County and surrounding Virginia areas."
          }
        },
        {
          "@type": "Question",
          "name": "Are golf carts street legal in Virginia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, golf carts can be street legal in Virginia with proper equipment (lights, mirrors, seat belts, horn, turn signals) and DMV registration. We handle street legal conversions and registration paperwork."
          }
        },
        {
          "@type": "Question",
          "name": "What areas do you serve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We serve Gloucester County (including Gloucester, Gloucester Point, Hayes, Seaford) and surrounding Virginia communities including Williamsburg, Yorktown, Hampton, Newport News, Mathews, and more - 19 communities total."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer financing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we provide flexible financing options with competitive rates and terms. Pre-approval is typically available within 24 hours."
