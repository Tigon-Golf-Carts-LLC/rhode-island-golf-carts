{
  "name": "Rhode Island Golf Carts",
  "short_name": "RI Golf Carts",
  "description": "Rhode Island Golf Carts - Rhode Island's premier DENAGO & EVOLUTION electric golf cart dealership serving Rhode Island and surrounding communities with sales, rentals, service and parts.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0e2e55",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "id": "rhodeislandgolfcarts",
  
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/favicon.png",
      "sizes": "48x48",
      "type": "image/png"
    }
  ],
  
  "categories": [
    "business",
    "automotive", 
    "shopping",
    "transportation",
    "lifestyle"
  ],
  
  "shortcuts": [
    {
      "name": "View Inventory",
