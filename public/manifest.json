      "description": "Browse our complete selection of DENAGO and EVOLUTION electric golf carts",
      "url": "/inventory",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Golf Cart Rentals",
      "short_name": "Rentals", 
      "description": "Daily, 3-day, weekly, and monthly golf cart rentals throughout Rhode Island",
      "url": "/rentals",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Service & Repair",
      "short_name": "Service",
      "description": "Professional golf cart service and repair for all brands",
      "url": "/services",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Contact Us",
      "short_name": "Contact",
      "description": "Get in touch with Rhode Island Golf Carts - Call 1-844-844-6638",
      "url": "/contact",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],

  "related_applications": [],
  "prefer_related_applications": false,

  "screenshots": [],

  "iarc_rating_id": "",

  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "use_cache": true
  },

  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+golfcart",
      "url": "/vehicle/%s"
    }
  ],

  "launch_handler": {
    "client_mode": "navigate-new"
  },

  "edge_side_panel": {
    "preferred_width": 400
  }
}
